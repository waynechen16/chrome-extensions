{
  "manifest_version": 3,
  "name": "Meeting Scribe 會議雙語筆記",
  "description": "會議即時逐字稿：多講者分離、中英夾雜辨識、繁中＋英文雙語譯文、會議記錄匯出",
  "version": "0.3.0",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.deepgram.com/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meeting Scribe"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
