{
  "manifest_version": 3,
  "name": "Live Translate Captions",
  "description": "直播 / 會議即時翻譯字幕：擷取分頁聲音 → Deepgram 逐字稿 → DeepL 翻譯 → 浮動字幕",
  "version": "0.4.0",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.deepgram.com/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Live Translate Captions"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
