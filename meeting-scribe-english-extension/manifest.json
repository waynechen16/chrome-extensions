{
  "manifest_version": 3,
  "name": "Meeting Scribe EN 純英文會議筆記",
  "description": "純英文會議即時逐字稿：英文專用辨識、多講者分離、繁中譯文、麥克風混音、低延遲、會議記錄匯出",
  "version": "0.5.5",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://api.deepgram.com/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meeting Scribe"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
